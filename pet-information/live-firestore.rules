rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "bibi@pawapp.net"
        && request.auth.token.firebase.sign_in_provider != "anonymous";
    }
    match /pet_appointments/{appointmentId} {
      // Only the verified PawApp staff account can read and edit customers.
      allow read, update: if staff();
      allow delete: if false;

      // A customer can only submit a NEW request and cannot access anyone's details.
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == "anonymous"
        && request.resource.data.id == appointmentId
        && request.resource.data.sourceRef == appointmentId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.isTest is bool
        && (
          (request.resource.data.isTest == true && appointmentId.matches('^PET-TEST-[a-zA-Z0-9-]+$'))
          || (request.resource.data.isTest == false && appointmentId.matches('^PET-LIVE-[a-f0-9-]+$'))
        )
        && request.resource.data.status == "new"
        && request.resource.data.paymentStatus == "unpaid"
        && request.resource.data.clinic == ""
        && request.resource.data.doctor == ""
        && request.resource.data.finalDate == ""
        && request.resource.data.finalTime == ""
        && request.resource.data.price == ""
        && request.resource.data.clinicShare == ""
        && request.resource.data.pawappShare == ""
        && request.resource.data.paymentLink == ""
        && request.resource.data.notes == ""
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() > 0
        && request.resource.data.clientName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{8}$')
        && request.resource.data.dogName is string
        && request.resource.data.dogName.size() <= 100
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 350
        && request.resource.data.originalNotes is string
        && request.resource.data.originalNotes.size() <= 600
        && request.resource.data.services is list
        && request.resource.data.services.size() <= 8
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.preferredTime is string
        && request.resource.data.preferredTime.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.keys().hasAll([
          'id','sourceRef','createdBy','isTest','clientName','phone','dogName',
          'petId','services','preferredDate','preferredTime','area','address','breed',
          'petAge','micro','annual','rabies','vaccineDate','originalNotes',
          'clinic','doctor','finalDate','finalTime','price','clinicShare',
          'pawappShare','paymentLink','paymentStatus','status','notes',
          'reminderDismissed','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id','sourceRef','createdBy','isTest','clientName','phone','dogName',
          'petId','services','preferredDate','preferredTime','area','address','breed',
          'petAge','micro','annual','rabies','vaccineDate','originalNotes',
          'clinic','doctor','finalDate','finalTime','price','clinicShare',
          'pawappShare','paymentLink','paymentStatus','status','notes',
          'reminderDismissed','createdAt','updatedAt'
        ]);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
